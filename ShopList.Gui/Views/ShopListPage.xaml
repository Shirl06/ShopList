<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel ="clr-namespace:ShopList.Gui.ViewModels"
             x:DataType="viewmodel:ShopListViewModel"
             x:Class="ShopList.Gui.Views.ShopListPage"
             Title="Lista de compras">
    <Grid
        RowDefinitions="auto, *"
        Padding="8"
        RowSpacing="6">
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            RowDefinitions="auto,auto"
            ColumnDefinitions="auto,*,auto,auto"
            RowSpacing="4"
            ColumnSpacing="4">
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Text="Producto: "
                VerticalOptions="Center"
                HorizontalOptions="End"
                FontSize="Medium"/>
            <Entry
                Grid.Row="0"
                Grid.Column="1"
                BackgroundColor="#F0F0F0"
                FontSize="Medium"/>
            <Label
                Grid.Row="1"
                Grid.Column="0"
                Text="Cantidad: "
                VerticalOptions="Center"
                HorizontalOptions="End"
                FontSize="Medium"/>
            <Entry
                Grid.Row="1"
                Grid.Column="1"
                BackgroundColor="#F0F0F0"
                FontSize="Medium"/>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                Text="+"
                FontSize="Medium"/>
            <Button
                Grid.Row="1"
                Grid.Column="2"
                Text="X"/>
        </Grid>

        <CollectionView
            Grid.Row="1"
            Grid.Column="0"
            ItemsSource="{Binding Items}"
            EmptyView="Aún no se han registrado productos"
            BackgroundColor="#f0f0f0">
            
        </CollectionView>
        
    </Grid>
</ContentPage>